# Binance API Credentials
# Get these from https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading Configuration
TRADING_MODE=paper  # paper or live (ALWAYS START WITH PAPER!)
TRADE_SYMBOL=BTCUSDT
TRADE_AMOUNT_USDT=100  # Amount in USDT per trade
MAX_POSITIONS=3  # Maximum number of open positions
RISK_PER_TRADE=0.02  # Risk 2% of capital per trade

# Strategy Settings
STRATEGY=rsi_macd  # rsi_macd, moving_average, or bollinger
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
